---
import rawData from '@data/anomaly_scatter.json';
const dataJSON = JSON.stringify(rawData);
---

<div class="pchart-wrap">
  <div id="anomaly-pchart" data-scatter={dataJSON}></div>
  <div class="pchart-legend">
    <span class="leg normal">Normal route-year</span>
    <span class="leg iad">IAD anomaly</span>
    <span class="leg dca">DCA anomaly</span>
    <span class="leg bwi">BWI anomaly</span>
  </div>
</div>

<div id="pchart-tooltip" class="pchart-tt" style="display:none"></div>

<script>
import {
  select, extent,
  scaleLinear,
  axisLeft,
  line,
} from 'd3';
import type { NumberValue } from 'd3';

interface Row {
  origin: string;
  dest: string;
  year: number;
  late_rate: number;
  mean_delay: number;
  nas_share: number;
  cancel_rate: number;
  is_anomalous: number;
}

interface Feature {
  key: keyof Row;
  label: string;
  fmt: (v: number) => string;
}

const container = document.getElementById('anomaly-pchart')!;
const raw: Row[] = JSON.parse(container.dataset.scatter!);

const FEATURES: Feature[] = [
  { key: 'late_rate',   label: 'Late-arrival rate', fmt: v => `${(v*100).toFixed(1)}%`  },
  { key: 'mean_delay',  label: 'Mean delay',         fmt: v => `+${v.toFixed(0)} min`    },
  { key: 'nas_share',   label: 'NAS delay share',    fmt: v => `${(v*100).toFixed(1)}%`  },
  { key: 'cancel_rate', label: 'Cancel rate',        fmt: v => `${(v*100).toFixed(1)}%`  },
];

const AP_COLOR: Record<string, string> = {
  IAD: '#4e9af1',
  DCA: '#f97316',
  BWI: '#22c55e',
};

// Build one averaged line per persistent route (flagged in ≥2 years).
// Each line is the mean of that route's anomalous-year feature values.
interface AvgRow {
  origin: string;
  dest: string;
  years_flagged: number;
  late_rate: number;
  mean_delay: number;
  nas_share: number;
  cancel_rate: number;
}

const yearCounts = new Map<string, number>();
const featureSums = new Map<string, { late_rate: number; mean_delay: number; nas_share: number; cancel_rate: number }>();
const originMap   = new Map<string, string>();

for (const d of raw) {
  if (d.is_anomalous !== 1) continue;
  const k = `${d.origin}|${d.dest}`;
  yearCounts.set(k, (yearCounts.get(k) ?? 0) + 1);
  originMap.set(k, d.origin);
  const s = featureSums.get(k) ?? { late_rate: 0, mean_delay: 0, nas_share: 0, cancel_rate: 0 };
  s.late_rate   += d.late_rate;
  s.mean_delay  += d.mean_delay;
  s.nas_share   += d.nas_share;
  s.cancel_rate += d.cancel_rate;
  featureSums.set(k, s);
}

const persistentRoutes: AvgRow[] = [];
for (const [k, n] of yearCounts.entries()) {
  if (n < 2) continue;
  const s = featureSums.get(k)!;
  const [origin, dest] = k.split('|');
  persistentRoutes.push({
    origin, dest,
    years_flagged: n,
    late_rate:   s.late_rate   / n,
    mean_delay:  s.mean_delay  / n,
    nas_share:   s.nas_share   / n,
    cancel_rate: s.cancel_rate / n,
  });
}

const tt = document.getElementById('pchart-tooltip')!;

function draw() {
  container.innerHTML = '';
  const W  = container.clientWidth || 680;
  const H  = Math.round(W * 0.58);
  const margin = { top: 48, right: 72, bottom: 16, left: 52 };
  const iW = W - margin.left - margin.right;
  const iH = H - margin.top - margin.bottom;

  const svg = select(container)
    .append('svg')
    .attr('width', W)
    .attr('height', H);

  const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);

  // Scales built on the full raw data so axes represent actual range
  const yScales = FEATURES.map(f =>
    scaleLinear()
      .domain(extent(raw, d => d[f.key] as number) as [number, number])
      .range([iH, 0])
      .nice()
  );

  const xPos = FEATURES.map((_, i) => (iW / (FEATURES.length - 1)) * i);

  function rowPath(d: Record<string, number>): string {
    const pts = FEATURES.map((f, i) => [xPos[i], yScales[i](d[f.key as string] as number)] as [number, number]);
    return line()(pts) ?? '';
  }

  // Gray background: all normal route-year observations
  const normal = raw.filter(d => d.is_anomalous === 0);
  g.append('g').attr('class', 'lines-normal')
    .selectAll<SVGPathElement, Row>('path')
    .data(normal)
    .join('path')
    .attr('d', d => rowPath(d as unknown as Record<string, number>))
    .attr('fill', 'none')
    .attr('stroke', '#3a3d4a')
    .attr('stroke-width', 0.8)
    .attr('stroke-opacity', 0.4);

  // One colored line per persistent route (averaged over anomalous years)
  const lastIdx  = FEATURES.length - 1;
  const lastFeat = FEATURES[lastIdx];

  const hoverLabel = g.append('text')
    .attr('dy', '0.35em')
    .attr('font-size', '11px')
    .attr('font-weight', '600')
    .attr('opacity', 0);

  const anomPaths = g.append('g').attr('class', 'lines-anomaly')
    .selectAll<SVGPathElement, AvgRow>('path')
    .data(persistentRoutes)
    .join('path')
    .attr('d', d => rowPath(d as unknown as Record<string, number>))
    .attr('fill', 'none')
    .attr('stroke', d => AP_COLOR[d.origin] ?? '#fff')
    .attr('stroke-width', 1.5)
    .attr('stroke-opacity', 0.6)
    .on('mousemove', function(event: MouseEvent, d: AvgRow) {
      anomPaths.attr('stroke-opacity', 0.08).attr('stroke-width', 0.8);
      select(this).attr('stroke-opacity', 1).attr('stroke-width', 2.5).raise();
      hoverLabel.raise();

      hoverLabel
        .attr('x', xPos[lastIdx] + 8)
        .attr('y', yScales[lastIdx](d[lastFeat.key as keyof AvgRow] as number))
        .attr('fill', AP_COLOR[d.origin] ?? '#fff')
        .attr('opacity', 1)
        .text(`${d.origin}→${d.dest}`);

      tt.style.display = 'block';
      tt.style.left = (event.pageX + 14) + 'px';
      tt.style.top  = (event.pageY - 28) + 'px';
      tt.innerHTML = `
        <strong>${d.origin} &rarr; ${d.dest}</strong>
        <span class="tt-year">${d.years_flagged} of 5 yrs</span><br>
        ${FEATURES.map(f => `${f.label}: <strong>${f.fmt(d[f.key as keyof AvgRow] as number)}</strong>`).join('<br>')}
      `;
    })
    .on('mouseleave', () => {
      anomPaths.attr('stroke-opacity', 0.6).attr('stroke-width', 1.5);
      hoverLabel.attr('opacity', 0);
      tt.style.display = 'none';
    });

  // Axes
  FEATURES.forEach((f, i) => {
    const axisG = g.append('g').attr('transform', `translate(${xPos[i]},0)`);

    axisG.append('line')
      .attr('y1', 0).attr('y2', iH)
      .attr('stroke', '#555').attr('stroke-width', 1);

    const isFirst = i === 0;
    const isLast  = i === FEATURES.length - 1;

    axisG.call(
      axisLeft(yScales[i]).ticks(4)
        .tickFormat((v: NumberValue) => f.fmt(+v))
    )
    .call(s => s.select('.domain').remove())
    .call(s => s.selectAll('text')
      .attr('fill', '#888')
      .attr('font-size', '10px')
      .attr('x', isFirst ? -6 : (isLast ? -6 : 0))
      .attr('text-anchor', isFirst ? 'end' : (isLast ? 'end' : 'middle'))
    )
    .call(s => s.selectAll('line').attr('stroke', '#555'));

    // Axis label — first axis right-aligned, last left-aligned, middle centered
    axisG.append('text')
      .attr('y', -22)
      .attr('text-anchor', isFirst ? 'start' : (isLast ? 'end' : 'middle'))
      .attr('x', isFirst ? -4 : (isLast ? -4 : 0))
      .attr('fill', '#bbb')
      .attr('font-size', '11px')
      .text(f.label);
  });
}

draw();
window.addEventListener('resize', () => draw());
</script>

<style>
  .pchart-wrap {
    margin-top: 1.5rem;
  }

  #anomaly-pchart svg {
    display: block;
    width: 100%;
    overflow: visible;
  }

  #anomaly-pchart {
    overflow: visible;
  }

  .pchart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    margin-bottom: 2rem;
    font-size: 0.8rem;
  }

  .leg {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
  }
  .leg::before {
    content: '';
    display: inline-block;
    width: 22px;
    height: 3px;
    border-radius: 2px;
  }
  .leg.normal::before  { background: #3a3d4a; }
  .leg.iad::before     { background: #4e9af1; }
  .leg.dca::before     { background: #f97316; }
  .leg.bwi::before     { background: #22c55e; }

  .pchart-tt {
    position: fixed;
    background: #1a1d27;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    color: var(--text);
    pointer-events: none;
    z-index: 100;
    line-height: 1.7;
    white-space: nowrap;
  }
  .pchart-tt .tt-year {
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
