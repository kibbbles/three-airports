---
import rawData from '@data/anomaly_scatter.json';
const dataJSON = JSON.stringify(rawData);
---

<div class="pchart-wrap">
  <div id="anomaly-pchart" data-scatter={dataJSON}></div>
  <div class="pchart-legend">
    <span class="leg normal">Normal route-year</span>
    <span class="leg iad">IAD anomaly</span>
    <span class="leg dca">DCA anomaly</span>
    <span class="leg bwi">BWI anomaly</span>
  </div>
</div>

<div id="pchart-tooltip" class="pchart-tt" style="display:none"></div>

<script>
import {
  select, extent,
  scaleLinear,
  axisLeft,
  line,
} from 'd3';
import type { NumberValue } from 'd3';

interface Row {
  origin: string;
  dest: string;
  year: number;
  late_rate: number;
  mean_delay: number;
  nas_share: number;
  cancel_rate: number;
  is_anomalous: number;
}

interface Feature {
  key: keyof Row;
  label: string;
  fmt: (v: number) => string;
}

const container = document.getElementById('anomaly-pchart')!;
const raw: Row[] = JSON.parse(container.dataset.scatter!);

const FEATURES: Feature[] = [
  { key: 'late_rate',   label: 'Late-arrival rate', fmt: v => `${(v*100).toFixed(1)}%`   },
  { key: 'mean_delay',  label: 'Mean delay',         fmt: v => `+${v.toFixed(0)} min`     },
  { key: 'nas_share',   label: 'NAS delay share',    fmt: v => `${(v*100).toFixed(1)}%`   },
  { key: 'cancel_rate', label: 'Cancellation rate',  fmt: v => `${(v*100).toFixed(1)}%`   },
];

const AP_COLOR: Record<string, string> = {
  IAD: '#4e9af1',
  DCA: '#f97316',
  BWI: '#22c55e',
};

const tt = document.getElementById('pchart-tooltip')!;

function draw() {
  container.innerHTML = '';
  const W  = container.clientWidth || 680;
  const H  = Math.round(W * 0.56);
  const margin = { top: 40, right: 20, bottom: 20, left: 20 };
  const iW = W - margin.left - margin.right;
  const iH = H - margin.top - margin.bottom;

  const svg = select(container)
    .append('svg')
    .attr('width', W)
    .attr('height', H);

  const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);

  // One y-scale per feature
  const yScales = FEATURES.map(f =>
    scaleLinear()
      .domain(extent(raw, d => d[f.key] as number) as [number, number])
      .range([iH, 0])
      .nice()
  );

  // Evenly spaced x positions for each axis
  const xPos = FEATURES.map((_, i) => (iW / (FEATURES.length - 1)) * i);

  // Path generator for a single row
  function rowPath(d: Row): string {
    const pts = FEATURES.map((f, i) => [xPos[i], yScales[i](d[f.key] as number)] as [number, number]);
    return line()(pts) ?? '';
  }

  const normal    = raw.filter(d => d.is_anomalous === 0);
  const anomalous = raw.filter(d => d.is_anomalous === 1);

  // Normal lines (behind, very faint)
  g.append('g').attr('class', 'lines-normal')
    .selectAll<SVGPathElement, Row>('path')
    .data(normal)
    .join('path')
    .attr('d', rowPath)
    .attr('fill', 'none')
    .attr('stroke', '#3a3d4a')
    .attr('stroke-width', 0.8)
    .attr('stroke-opacity', 0.4);

  // Anomalous lines (colored, interactive)
  const anomPaths = g.append('g').attr('class', 'lines-anomaly')
    .selectAll<SVGPathElement, Row>('path')
    .data(anomalous)
    .join('path')
    .attr('d', rowPath)
    .attr('fill', 'none')
    .attr('stroke', d => AP_COLOR[d.origin] ?? '#fff')
    .attr('stroke-width', 1.4)
    .attr('stroke-opacity', 0.55)
    .on('mousemove', function(event: MouseEvent, d: Row) {
      // Highlight this line, dim others
      anomPaths.attr('stroke-opacity', 0.1).attr('stroke-width', 0.8);
      select(this)
        .attr('stroke-opacity', 1)
        .attr('stroke-width', 2.5)
        .raise();

      tt.style.display = 'block';
      tt.style.left = (event.pageX + 14) + 'px';
      tt.style.top  = (event.pageY - 28) + 'px';
      tt.innerHTML = `
        <strong>${d.origin} &rarr; ${d.dest}</strong> <span class="tt-year">${d.year}</span><br>
        ${FEATURES.map(f => `${f.label}: <strong>${f.fmt(d[f.key] as number)}</strong>`).join('<br>')}
      `;
    })
    .on('mouseleave', () => {
      anomPaths.attr('stroke-opacity', 0.55).attr('stroke-width', 1.4);
      tt.style.display = 'none';
    });

  // Axis lines + ticks
  FEATURES.forEach((f, i) => {
    const axisG = g.append('g').attr('transform', `translate(${xPos[i]},0)`);

    // Vertical axis line
    axisG.append('line')
      .attr('y1', 0).attr('y2', iH)
      .attr('stroke', '#444').attr('stroke-width', 1);

    // Ticks
    axisG.call(
      axisLeft(yScales[i]).ticks(4)
        .tickFormat((v: NumberValue) => f.fmt(+v))
    )
    .call(s => s.select('.domain').remove())
    .call(s => s.selectAll('text')
      .attr('fill', '#888')
      .attr('font-size', '10px')
      .attr('x', i === 0 ? -6 : (i === FEATURES.length - 1 ? 6 : 0))
      .attr('text-anchor', i === 0 ? 'end' : (i === FEATURES.length - 1 ? 'start' : 'middle'))
    )
    .call(s => s.selectAll('line').attr('stroke', '#444'));

    // Axis label at top
    axisG.append('text')
      .attr('y', -14)
      .attr('text-anchor', 'middle')
      .attr('fill', '#aaa')
      .attr('font-size', '11px')
      .text(f.label);
  });
}

draw();
window.addEventListener('resize', () => draw());
</script>

<style>
  .pchart-wrap {
    margin-top: 1.5rem;
  }

  #anomaly-pchart svg {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .pchart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.75rem;
    margin-bottom: 2rem;
    font-size: 0.8rem;
  }

  .leg {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
  }
  .leg::before {
    content: '';
    display: inline-block;
    width: 22px;
    height: 3px;
    border-radius: 2px;
  }
  .leg.normal::before  { background: #3a3d4a; }
  .leg.iad::before     { background: #4e9af1; }
  .leg.dca::before     { background: #f97316; }
  .leg.bwi::before     { background: #22c55e; }

  .pchart-tt {
    position: fixed;
    background: #1a1d27;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.8rem;
    color: var(--text);
    pointer-events: none;
    z-index: 100;
    line-height: 1.7;
    white-space: nowrap;
  }
  .pchart-tt .tt-year {
    color: var(--muted);
    font-size: 0.75rem;
  }
</style>
